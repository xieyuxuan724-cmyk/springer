    </collision>
  </link>
  <joint name="LW" type="continuous">
    <origin xyz="0 0.008 -0.075" rpy="0 0 0"/>
    <parent link="L2_Link"/>
    <child link="LW_Link"/>
    <axis xyz="0 -1 0"/>
    <limit effort="0.6" velocity="400"/>
  </joint>
  <link name="R1_Link">
    <inertial>
      <origin xyz="-0.008230681600000001 0.005782016300000001 0.0008501348800000001" rpy="0 0 0"/>
      <mass value="0.26100817"/>
      <inertia ixx="0.00010581644" ixy="-3.2467542e-5" ixz="6.1594071e-6" iyy="0.00016271403000000002" iyz="1.2252857e-5" izz="0.00018314794"/>
    </inertial>
    <visual>
      <origin xyz="-0.0325072227328 0.048 -0.105087013804" rpy="1.57079632679 0.3 0"/>
      <geometry>
        <mesh filename="../meshes/VIS_R1_Link_00_R1_VIS.obj"/>
      </geometry>
      <material name="mat_beni"/>
    </visual>
    <collision>
      <origin xyz="-0.03 -0.02 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.13 0.03 0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="R1" type="revolute">
    <origin xyz="0 -0.048 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="R1_Link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.5307" upper="6.8940" effort="1.375" velocity="209"/>
  </joint>
  <link name="R2_Link">
    <inertial>
      <origin xyz="0.00016609656 -0.005196929800000001 -0.062290377999999993" rpy="0 0 0"/>
      <mass value="0.08287119"/>
      <inertia ixx="7.0858589e-5" ixy="-9.7216964e-8" ixz="-5.991245400000001e-7" iyy="7.582624900000001e-5" iyz="-8.7535112e-6" izz="1.3020969e-5"/>
    </inertial>
    <visual>

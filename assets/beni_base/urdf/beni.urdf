<robot name="beni">
  <mujoco>
    <compiler meshdir="../meshes/" balanceinertia="true" discardvisual="false" fusestatic="false"/>
  </mujoco>
  <material name="mat_beni">
    <color rgba="1 1 1 1"/>
    <texture filename="../textures/beni_white.png"/>
  </material>
  <!-- Visual origins place the unmodified Y-up OBJ exports in each link's frame.
       The source pose has base z=0.11 m, L1/R1=0.3 rad and L2/R2=0.5 rad. -->
  <!-- Collision uses coarse exterior boxes and cylinders; no internal CAD meshes. -->
  <link name="root_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="root_to_base_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="root_link"/>
    <child link="base_link"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="base_link">
    <inertial>
      <origin xyz="-0.026830109 -0.00097765393 -0.0006967038800000001" rpy="0 0 0"/>
      <mass value="0.60837039"/>
      <inertia ixx="0.0005842953" ixy="4.5142416e-5" ixz="-1.617345e-5" iyy="0.0017198711" iyz="2.7632628e-6" izz="0.0016573369"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.11" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="../meshes/VIS_base_link_00_BASE_VIS.obj"/>
      </geometry>
      <material name="mat_beni"/>
    </visual>
    <collision>
      <origin xyz="-0.005 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.08 0.07"/>
      </geometry>
    </collision>
  </link>
  <link name="head_intermediate">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="head_yaw_joint" type="revolute">
    <origin xyz="-0.000 0 0.0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="head_intermediate"/>
    <axis xyz="0 0 1"/>
    <limit lower="-5.20" upper="5.20" effort="0.1" velocity="400.0"/>
  </joint>
  <link name="head">
    <inertial>
      <origin xyz="0.0057515429 -3.3763401999999995e-5 0.030715793999999998" rpy="0 0 0"/>
      <mass value="0.22713973"/>
      <inertia ixx="0.00021585924" ixy="-1.4175017000000002e-7" ixz="-8.913237299999999e-7" iyy="0.00023532522" iyz="1.6379191e-7" izz="0.00035076542"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1469" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="../meshes/VIS_head_00_HEAD_VIS.obj"/>
      </geometry>
      <material name="mat_beni"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.12 0.07"/>
      </geometry>
    </collision>
  </link>
  <joint name="head_roll_joint" type="revolute">
    <origin xyz="0 0 0.0369" rpy="0 0 0"/>
    <parent link="head_intermediate"/>
    <child link="head"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.05" upper="0.05" effort="1000.0" velocity="1000.0"/>
  </joint>
  <link name="L1_Link">
    <inertial>
      <origin xyz="-0.008230681600000001 -0.005782016300000001 0.0008501348800000001" rpy="0 0 0"/>
      <mass value="0.26100817"/>

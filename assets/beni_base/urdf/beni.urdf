      <geometry>
        <box size="0.015 0.01 0.065"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 -0.075" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.02"/>
      </geometry>
    </collision>
  </link>
  <joint name="L2" type="revolute">
    <origin xyz="-0.07 0.024 0" rpy="0 0 0"/>
    <parent link="L1_Link"/>
    <child link="L2_Link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.7853981633974483" upper="1.1344640137963142" effort="3.6" velocity="149"/>
  </joint>
  <link name="LW_Link">
    <inertial>
      <origin xyz="2.2944408999999998e-5 0.01067511 0.00017766532" rpy="0 0 0"/>
      <mass value="0.076978199"/>
      <inertia ixx="2.4617683e-5" ixy="-1.6383694e-8" ixz="7.8264342e-9" iyy="3.9531034e-5" iyz="-1.4443679000000002e-7" izz="2.4625466e-5"/>
